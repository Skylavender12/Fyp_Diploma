  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 4680ce3306fdac6459c178d9265ea81f, type: 3}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "I felt a warm feeling throughout my body and a sharp pain from my back.
    I collapsed under the exhaustion and the sudden pain I felt. I reached back and
    felt a large gaping wound. They caught me. I couldn\u2019t move, I could only
    slump over. The pain was unbearable. Then, I felt a kick at the side of me and
    I tumbled over.  I groaned and opened my eyes; to see two men standing over me.
    I gasped for breath, and when I was about others to beg, plead to spare my life,
    I saw the men plunge a sword right through my heart. I woke up. I was at the
    entrance of the village, but how? How am I here? I could have sworn that I got
    stabbed through the heart. I still feel the pain but when I checked. There is
    no wound nor injuries. Was it all a dream? \u201CNo, no it can\u2019t be. The
    village is still burning my fellow village men are lying there dead on the ground\u201D,
    I tried to question, but before I could ponder more of this bizarre incident.
    The same galloping and shouts are heard again heading towards the village. In
    fear of what happened before I ran, but I took a different path instead. Maybe
    this time things will change; I hoped as I ran. Clinging to my life."
