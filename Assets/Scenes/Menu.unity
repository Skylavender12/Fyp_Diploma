--- !u!114 &259988099
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 259988097}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 4680ce3306fdac6459c178d9265ea81f, type: 3}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "I died once again. This time an arrow through my head. I woke up on the
    same area as I had previously. \u201CWhat is going on?\u201D, I pondered. Then
    it struct me. Maybe this is a gift that the gods have bestowed upon me. Perhaps
    I am meant to be alive. To find and punish the murderer who have taken many of
    my village\u2019s life\u2019s. first and foremost, I have to recall back my memories.
    To figure out the tragic event that occurred. The same men galloped towards me.
    Although I wanted to fight back, I am no warrior, all I could do is run. If I
    can outrun them and managed to reach the other town. I might be able to avenge
    my fallen friends."
--- !u!222 &259988100
